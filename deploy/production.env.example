# Never commit real values. Copy to secrets/production.env (Git-ignored), chmod 600,
# and invoke Compose with --env-file secrets/production.env.
MONGO_ROOT_USERNAME=laundryvibes_admin
MONGO_ROOT_PASSWORD=generate-a-long-random-value
MONGO_APP_USERNAME=laundryvibes_app
MONGO_APP_PASSWORD=generate-an-independent-long-url-safe-value
MONGODB_URL=mongodb://laundryvibes_app:generate-an-independent-long-url-safe-value@mongo:27017/laundryvibes?authSource=laundryvibes
JWT_SECRET=generate-at-least-32-random-characters
FRONTEND_URL=https://laundry.example.com
CORS_ORIGINS=https://laundry.example.com
JWT_EXPIRES_IN=1h
RESET_TOKEN_TTL_MINUTES=15
PAYLOAD_LIMIT=100kb
EMAIL_USER=
EMAIL_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
